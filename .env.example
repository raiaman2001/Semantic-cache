# ==========================================
# Semantic Cache Configuration
# ==========================================

# Security & Access
CACHE_API_KEY=
RATE_LIMIT=120
MAX_QUERY_LENGTH=4096
MAX_ENTRIES=500
TTL=86400

# Thresholds & Precision Matching
BASE_THRESHOLD_CODE=0.93
BASE_THRESHOLD_GENERAL=0.88
RERANK=1
RERANK_MIN=0.6

# Storage & Infrastructure (Leave blank for local embedded SQLite / Qdrant)
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_PATH=qdrant_data
SQLITE_DB_PATH=cache.db

# LLM & Fallback Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# Observability
LOG_LEVEL=INFO

